# ─── API Keys ───────────────────────────────
# Get free key at https://serper.dev (2,500 free searches)
SERPER_API_KEY=

# Get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Mode ───────────────────────────────────
# Set to true to use demo data (no API keys needed)
DEMO_MODE=true

# ─── Database ───────────────────────────────
# SQLite is used by default. For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pricetracker

# ─── Cache ──────────────────────────────────
CACHE_TTL_SEARCH=3600
CACHE_TTL_PRICE=300
CACHE_TTL_HISTORY=86400

# ─── Server ─────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
